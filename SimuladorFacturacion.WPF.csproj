<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimuladorFacturacion.WPF</RootNamespace>
    <AssemblyName>SimuladorFacturacion.WPF</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Paquete oficial de Microsoft para MVVM moderno con Source Generators -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
